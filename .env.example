# -----------------------------------------------------------------------------
# Old Brush · Environment variables
#
# All integrations are OPTIONAL in v1. The site builds and runs without any
# of them — features degrade *visibly* (never silent simulation).
#
# Copy this file to .env.local when credentials are provisioned. Never commit
# the real .env.local — it is ignored by git.
# -----------------------------------------------------------------------------

# Vercel Blob — attachments for the contact form (up to 5 files, 20 MB total).
# Provision via `vercel blob` in the Vercel dashboard or CLI.
BLOB_READ_WRITE_TOKEN=

# Upstash Redis — rate limiting (5 enquiries / 10 min / IP) and idempotency.
# Provision via the Vercel Marketplace: `vercel integration add upstash`.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Resend — transactional email (internal notification + client auto-reply).
# https://resend.com  ·  Marketplace: `vercel integration add resend`.
RESEND_API_KEY=
RESEND_FROM="Old Brush <hello@oldbrush.co.nz>"
RESEND_TO_INTERNAL=cristian@oldbrush.co.nz

# Trello — optional lead card. Leave blank to disable.
TRELLO_KEY=
TRELLO_TOKEN=
TRELLO_LIST_ID=

# Telegram — optional internal notification. Leave blank to disable.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Site URL override — leave blank. src/lib/seo.ts resolves the OG image /
# canonical base URL automatically (Vercel's production domain, falling
# back to the current deployment's own URL, falling back to brand.url).
# Only set this to force a specific domain regardless of environment.
SITE_URL=
